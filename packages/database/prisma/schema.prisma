// Agency Website — core schema.
// Conventions used throughout (see architecture plan):
//   - cuid ids, createdAt/updatedAt on every model
//   - ContentStatus + `order` Int on anything manageable/orderable from the admin panel
//   - slug (unique) on anything with its own public URL
//   - optional 1:1 SeoMeta relation on anything that renders its own page
//   - Media is the single source of truth for Cloudinary assets

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TechCategory {
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  DESIGN
  TOOL
}

enum FaqContext {
  GENERAL
  SERVICE
  PORTFOLIO
  CONTACT
  AFFILIATE
  INFLUENCER
}

enum NavLocation {
  HEADER
  FOOTER
}

enum SubmissionStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  ARCHIVED
}

enum BillingType {
  ONE_TIME
  HOURLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PricingType {
  FIXED
  ONE_TIME
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  RETAINER
  CUSTOM
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  STRIPE
  PAYPAL
  WISE
  JAZZCASH
  EASYPAISA
  CUSTOM
}

