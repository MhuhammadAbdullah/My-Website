{
  "name": "@agency/auth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./influencer-server": {
      "types": "./dist/influencer-server.d.ts",
      "default": "./dist/influencer-server.js"
    },
    "./influencer-client": {
      "types": "./dist/influencer-client.d.ts",
      "default": "./dist/influencer-client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agency/database": "workspace:*",
    "@better-auth/infra": "^0.4.20",
    "better-auth": "^1.7.10"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@agency/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
